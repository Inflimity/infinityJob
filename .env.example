# ==============================================================================
# Infinity Job Search — Environment Configuration
# ==============================================================================

# ── Telegram Bot (Instant Alerts & Pitch Callbacks) ───────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Your personal Telegram user ID (use @userinfobot to find it)
ADMIN_CHAT_ID=123456789

# ── Minimum Alert & Digest Scoring Thresholds ─────────────────────────────────
# Score threshold (0-100) to trigger an immediate Telegram DM
MIN_ALERT_SCORE=70
# Score threshold (0-100) to save the job to SQLite database
DIGEST_MIN_SCORE=50

# ── Reddit Subreddits to Monitor ──────────────────────────────────────────────
# Comma-separated list of subreddits to monitor for hiring posts
REDDIT_SUBREDDITS=forhire,jobbit,remotejs,pythonjobs,reactjs,nextjs,Automate,businessanalysis,dataanalysis,analytics
# Optional Reddit API credentials (if omitted, bot uses RSS feeds automatically)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=JobSearchBot/1.0

# ── Remote Boards & APIs (Himalayas, WWR, Jobicy, Arbeitnow) ───────────────────
REMOTE_BOARDS_ENABLED=true
HN_SEARCH_ENABLED=true
GITHUB_BOUNTIES_ENABLED=true
# Optional GitHub token for higher rate limits on bounty search
GITHUB_TOKEN=

# ── X (Twitter) Search Queries ────────────────────────────────────────────────
# Optional additional search queries (default boolean queries are built-in)
TWITTER_SEARCH_QUERIES=

# ── Optional Telegram Userbot (for Telegram Job Groups) ──────────────────────
# Telethon API ID & Hash from my.telegram.org (optional)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Database & Deduplication ───────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./ginNews.sqlite
# Optional Redis URL (defaults to in-memory TTL dedup if empty)
REDIS_URL=
DEDUP_TTL_SECONDS=86400
POLL_INTERVAL_SECONDS=30
