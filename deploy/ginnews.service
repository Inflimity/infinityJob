[Unit]
Description=ginNews Cross-Platform Surveillance Relay
After=network.target redis.service
# Uncomment if using local Redis
# Requires=redis.service

[Service]
Type=simple
User=yourusername
Group=yourgroup
WorkingDirectory=/path/to/ginNews

# Path to the virtual environment python
ExecStart=/path/to/ginNews/.venv/bin/python main.py

# Restart policy
Restart=on-failure
RestartSec=10

# Environment variables (can also be loaded from .env)
# Environment="REDIS_URL=redis://localhost:6379/0"

# Logging (systemd handles this, view with `journalctl -u ginnews -f`)
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=ginnews

[Install]
WantedBy=multi-user.target
